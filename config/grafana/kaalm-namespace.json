      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(increase(kaalm_hibernations_total{namespace=\"$namespace\"}[5m]))",
          "refId": "A",
          "range": true,
          "legendFormat": "hibernations"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (trigger) (increase(kaalm_wakes_total{namespace=\"$namespace\"}[5m]))",
          "refId": "B",
          "range": true,
          "legendFormat": "wakes ({{trigger}})"
        }
